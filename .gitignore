# --- Conda / venv created inside the repo (env.lock IS tracked, see CLAUDE.md §6) ---
.venv/
venv/
env/

# --- Third-party clones & downloaded PDFs: regenerable via `bash setup_workspace.sh`,
#     read-only per CLAUDE.md, and too large / nested-git to version here. Keep the dirs via .gitkeep. ---
/source/*
!/source/.gitkeep
/papers/*
!/papers/.gitkeep

# --- Large runtime artifacts (created later; CoT jsonl is anonymized & shipped at submission, not in main history) ---
*.pt
*.npz
mom2_stats/
stats/
/deltas/

# --- Cleaned datasets: regenerable via `python src/build_dataset.py` (raw via memit download).
#     aliases.json + sample_records.jsonl + *.prefiltered.jsonl stay tracked (small / pins pilot set). ---
/data/raw/
/data/counterfact.jsonl
/data/zsre.jsonl
/data/mquake_cf_3k.jsonl

# --- Pilot/main results: CoT jsonl, large, regenerable on GPU (anonymized & shipped at submission) ---
/results/
results 2/
/results_*/
/results.tar.gz
/results*.tar.gz

# --- EasyEdit runtime logs (make_logs() writes logs/run.log + results.json whenever an editor runs) ---
/logs/

# --- Offline-deploy staging for the intranet (qizhi) platform: huge tars/wheels, regenerable
#     per interplan2.md §1; the bundle is a transfer artifact, .obsidian is editor junk ---
/_upload/
/whyaaai.bundle
.obsidian/

