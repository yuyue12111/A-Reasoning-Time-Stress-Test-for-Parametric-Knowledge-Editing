+def _prefix_sha(path, n):
+    """sha256 of the first n bytes of path (None if the file is shorter)."""
+    h = hashlib.sha256()
+    left = n
+    with open(path, 'rb') as fh:
+        while left > 0:
+            b = fh.read(min(1 << 20, left))
+            if not b:
+                break
+            h.update(b)
+            left -= len(b)
+    return h.hexdigest() if left == 0 else None
+
